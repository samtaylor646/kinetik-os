###############################################################################
# Path: /.gitignore
# Filename: .gitignore | Version: v7.8.0
# Agent: DevOps-V
# Status: Production
# Logic: Git ignore patterns for Kinetik-OS project
###############################################################################

# Environment files
.env
.env.development
.env.production
.env.local
.env.*.local

# Dependencies
/node_modules
/vendor

# Build outputs
/public/dist
/public/media/*
!/public/media/.gitkeep

# Kirby cache and storage
/storage/cache/*
!/storage/cache/.gitkeep
/storage/sessions/*
!/storage/sessions/.gitkeep
/storage/accounts/*
!/storage/accounts/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# IDE and editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS files
Desktop.ini
ehthumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
/coverage
/.nyc_output
/playwright-report
/test-results

# Temporary files
/tmp
/temp
*.tmp

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory
.Trash-*

# AI Agents
.roo-tasks/
.roo-tasks-archive/

###############################################################################
# Path: /.env.example
# Filename: .env.example | Version: v7.8.0
# Agent: DevOps-V
# Status: Production
# Logic: Environment variables template for Kinetik-OS development
###############################################################################

# Application Environment
APP_ENV=development
APP_DEBUG=true

# Kirby Configuration
KIRBY_DEBUG=true
KIRBY_PANEL_INSTALL=true
KIRBY_CACHE=false

# PHP Configuration
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Vite Configuration
VITE_HOST=0.0.0.0
VITE_PORT=3000
VITE_HMR_CLIENT_PORT=3000

# Site Information
SITE_URL=http://localhost:8000
SITE_TITLE="Kinetik-OS V7.8.0"

# Security (Change in production!)
APP_KEY=your-random-app-key-here

# Database - NOT USED (Flat-file architecture)
# DO NOT ENABLE DATABASE

# AWS Configuration (Production only)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# CLOUDFRONT_URL=

# Mail Configuration (Optional)
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@kinetik-os.local
# MAIL_FROM_NAME="Kinetik-OS"

# Development Tools
XDEBUG_MODE=debug,develop
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

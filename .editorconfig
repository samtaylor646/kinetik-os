# Path: /.editorconfig
# Filename: .editorconfig | Version: v7.8.0
# Agent: DevOps-V
# Status: Production
# Logic: EditorConfig for consistent coding standards

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.php]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{js,ts,jsx,tsx}]
indent_size = 2
quote_type = single

[*.{css,scss}]
indent_size = 2

[Makefile]
indent_style = tab

[Dockerfile]
indent_style = tab

[*.sh]
indent_size = 2
